# ==============================================================================
# Tenet Framework Configuration Instance
# ==============================================================================
# Use this file as a template for your local .env file.
# IMPORTANT: Never commit your actual .env file to version control.

# ------------------------------------------------------------------------------
# 🛰️ Core Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=localhost
SERVICE_NAME=tenet-api

# ------------------------------------------------------------------------------
# 🗄️ Database (Prisma / PostgreSQL)
# ------------------------------------------------------------------------------
# See: https://www.prisma.io/docs/concepts/database-connectors/postgresql
DATABASE_URL="postgresql://postgres:password@localhost:5432/tenet_db?schema=public"
DB_POOL_SIZE=10
DB_SSL=false
DB_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 🔒 Security & Cryptography
# ------------------------------------------------------------------------------
# JWT_SECRET: Minimum 32 characters for security
JWT_SECRET="generate-a-secure-random-secret-for-production-usage"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="tenet-api"

# ENCRYPTION_KEY: Must be exactly 32 bytes (64 hex chars) for AES-256-GCM
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# CSRF & Headers
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 🏢 Multi-Tenancy Architecture (Always Enabled)
# ------------------------------------------------------------------------------
TENANT_HEADER="X-Tenant-ID"

# ------------------------------------------------------------------------------
# ⚡ Performance & Caching (Redis)
# ------------------------------------------------------------------------------
# Provider: 'redis', 'memory', or 'none'
CACHE_PROVIDER=memory
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
CACHE_DEFAULT_TTL=300
RATE_LIMITING_ENABLED=true

# ------------------------------------------------------------------------------
# 📊 Monitoring & Logging
# ------------------------------------------------------------------------------
# Provider: 'console', 'datadog', 'newrelic', or 'none'
MONITORING_PROVIDER=console

# ------------------------------------------------------------------------------
# 🚩 Feature Management
# ------------------------------------------------------------------------------
# Global JSON object
FEATURE_FLAGS='{"beta-access": false}'

# Individual flags (prefix with FEATURE_)
FEATURE_NEW_AUDIT_DASHBOARD=false
